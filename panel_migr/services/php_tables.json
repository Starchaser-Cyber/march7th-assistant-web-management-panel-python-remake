    "notify_gotify_priority": {
     "label": "优先级（1-10）",
     "type": "int",
     "tip": "数字越大通知越「重要」，默认 5"
    }
   }
  },
  "notify_discord": {
   "title": "Discord",
   "icon": "🎮",
   "fields": {
    "notify_discord_enable": {
     "label": "启用 Discord",
     "type": "bool",
     "tip": "服务器能访问 Discord 时可用"
    },
    "notify_discord_webhook": {
     "label": "Webhook URL",
     "type": "password",
     "placeholder": "https://discord.com/api/webhooks/xxx",
