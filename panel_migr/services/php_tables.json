    },
    "notify_lark_sign": {
     "label": "签名密钥",
     "type": "password",
     "placeholder": "可选",
     "tip": "机器人安全设置选了「签名校验」时才填"
    },
    "notify_lark_content": {
     "label": "消息内容",
     "type": "str",
     "placeholder": "可选",
     "tip": "自定义消息模板，留空用默认内容"
    },
    "notify_lark_imageenable": {
     "label": "图片消息",
     "type": "bool",
     "tip": "开启后可推送截图，需要自建飞书应用"
    },
    "notify_lark_appid": {
     "label": "应用 AppID",
     "type": "str",
     "placeholder": "图片消息必填",
     "tip": "飞书开放平台自建应用的 AppID"
    },
    "notify_lark_secret": {
     "label": "应用 Secret",
     "type": "password",
     "placeholder": "图片消息必填",
     "tip": "飞书开放平台自建应用的 App Secret"
    }
   }
  },
  "notify_telegram": {
   "title": "Telegram",
   "icon": "✈️",
   "fields": {
    "notify_telegram_enable": {
     "label": "启用 Telegram",
     "type": "bool",
     "tip": "服务器需能访问 Telegram，国内服务器通常要配代理"
    },
    "notify_telegram_token": {
     "label": "Bot Token",
     "type": "password",
     "placeholder": "BotFather 获取",
     "tip": "在 Telegram 里找 @BotFather 创建机器人后复制 Token"
    },
    "notify_telegram_userid": {
     "label": "接收用户/群组 ID",
     "type": "str",
     "placeholder": "如 123456789",
     "tip": "私聊 ID 找 @userinfobot 获取；群组填 -100 开头的 ID"
    },
    "notify_telegram_api_url": {
     "label": "自定义 API URL",
     "type": "str",
     "placeholder": "可选",
     "tip": "只有自建反向代理/中转服务器才填"
    },
    "notify_telegram_proxies": {
     "label": "代理地址",
     "type": "str",
     "placeholder": "如 127.0.0.1:10808",
     "tip": "容器内可访问的代理地址，一般留空"
    },
    "notify_telegram_thread_id": {
     "label": "Topics 线程 ID",
     "type": "str",
     "placeholder": "可选",
     "tip": "群组开了话题（Topics）时才需要"
    }
   }
  },
  "notify_gotify": {
   "title": "Gotify（自建）",
   "icon": "🔧",
   "fields": {
    "notify_gotify_enable": {
     "label": "启用 Gotify",
     "type": "bool",
     "tip": "自建推送服务，适合不想依赖第三方推送的用户"
